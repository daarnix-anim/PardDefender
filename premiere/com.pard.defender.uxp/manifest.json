{
  "manifestVersion": 5,
  "id": "com.pard.defender.uxp",
  "name": "PardDefender",
  "version": "2.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "premierepro",
      "minVersion": "25.6"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "parddefender.panel",
      "label": {
        "default": "PardDefender"
      },
      "minimumSize": { "width": 260, "height": 300 },
      "maximumSize": { "width": 800, "height": 1200 },
      "preferredDockedSize": { "width": 300, "height": 500 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "clipboard": "readAndWrite",
    "launchProcess": {
      "schemes": ["https"]
    }
  },
  "icons": [
    { "width": 23, "height": 23, "path": "icons/icon-23.png" }
  ]
}
