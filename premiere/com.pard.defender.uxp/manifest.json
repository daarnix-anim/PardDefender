{
  "manifestVersion": 5,
  "id": "com.pard.defender.uxp",
  "name": "PardDefender",
  "version": "2.0.3",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "mainPanel",
      "label": {
        "default": "PardDefender"
      },
      "minimumSize": { "width": 260, "height": 300 },
      "maximumSize": { "width": 1200, "height": 1600 },
      "preferredDockedSize": { "width": 320, "height": 600 },
      "preferredFloatingSize": { "width": 400, "height": 650 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "clipboard": "readAndWrite",
    "allowCodeGenerationFromStrings": true
  },
  "icons": [
    { "width": 23, "height": 23, "path": "icons/icon-23.png" }
  ]
}
