<?xml version="1.0" encoding="UTF-8"?>
<!-- @map role: Манифест CEP: версия, поддерживаемые версии AE, включение Node и геометрия панели.  @map status: ready  @map layer: config -->
<ExtensionManifest Version="7.0"
    ExtensionBundleId="com.pard.defender"
    ExtensionBundleVersion="1.2.1"
    ExtensionBundleName="PardDefender">
    <ExtensionList>
        <Extension Id="com.pard.defender.panel" Version="1.2.1" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <Host Name="AEFT" Version="[17.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="9.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.pard.defender.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/index.html</MainPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>PardDefender</Menu>
                    <Geometry>
                        <Size><Width>380</Width><Height>560</Height></Size>
                        <MinSize><Width>300</Width><Height>280</Height></MinSize>
                        <MaxSize><Width>1400</Width><Height>1400</Height></MaxSize>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
